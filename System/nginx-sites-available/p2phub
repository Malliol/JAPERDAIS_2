map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    server_name osgo.malliol.ru;
    root /var/www/p2phub;
    index index.html;

    location /admin {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /ws {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/osgo.malliol.ru/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/osgo.malliol.ru/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}


server {
    if ($host = osgo.malliol.ru) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name osgo.malliol.ru;
    return 404; # managed by Certbot


}
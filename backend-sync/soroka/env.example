# Скопируй в .env рядом и вставь токен, который выдал @BotFather в Telegram.
BOT_TOKEN=PASTE_YOUR_TOKEN_HERE
# Telegram user id владельца — только ему видна команда /app и доступ к мини-приложению.
# Свой id можно узнать у @userinfobot.
ALLOWED_USER_ID=PASTE_YOUR_TELEGRAM_USER_ID_HERE
# Публичный адрес мини-приложения (см. miniapp-api.mjs + nginx location /soroka/).
MINIAPP_URL=https://japerdais.malliol.ru/soroka/

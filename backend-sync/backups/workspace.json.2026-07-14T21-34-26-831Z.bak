     "_notionDetail": 1
    },
    {
     "type": "paragraph",
     "text": "",
     "_notionDetail": 1
    },
    {
     "type": "paragraph",
     "text": "Как ОН относится к людям",
     "_notionDetail": 1
    },
    {
     "type": "paragraph",
     "text": "Как о НЁМ высказываются",
     "_notionDetail": 1
